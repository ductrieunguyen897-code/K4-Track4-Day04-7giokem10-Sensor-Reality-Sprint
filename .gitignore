# Results & outputs (keep directory structure via .gitkeep)
# Bằng chứng đo phải nằm trong repo (plan §6). Các phiên chính thức khác vẫn
# bị bỏ qua cho tới khi TV5 chốt; riêng phiên pilot TV3 được commit làm bằng chứng.
results/*
!results/.gitkeep
!results/session_tv3_pilot_02/
!results/session_tv3_pilot_02/**
plots/*
!plots/.gitkeep
!plots/plot.py
logs/*
!logs/.gitkeep

